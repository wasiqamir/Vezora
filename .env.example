# Local development uses Prisma Postgres, started with `npm run db:dev`.
# The command prints the connection string. Ports can differ from these examples.
# Production uses a managed PostgreSQL database. Set DIRECT_URL to the
# direct connection string when the host gives you a pooled DATABASE_URL.

DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
AUTH_SECRET="replace-with-a-long-random-string"
